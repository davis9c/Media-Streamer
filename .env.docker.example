# Salin menjadi .env.docker lalu sesuaikan nilainya.
#   cp .env.docker.example .env.docker
#
# File ini dibaca Docker Compose, lalu entrypoint menulis .env CodeIgniter
# di dalam container berdasarkan nilai-nilai di bawah.

APP_PORT=8080
APP_BASE_URL=http://localhost:8080/
CI_ENVIRONMENT=production

# Database eksternal (bukan container).
# Di Linux, host.docker.internal disediakan lewat extra_hosts host-gateway.
# Jika database berada di mesin lain, ganti dengan IP/hostname-nya.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_ar_streaming
DB_USERNAME=streaming
DB_PASSWORD=streaming123
DB_DRIVER=MySQLi

# Konversi HLS
HLS_ENABLED=true
HLS_FFMPEG_PATH=/usr/bin/ffmpeg

# Opsional
WAIT_FOR_DB=true
RUN_MIGRATIONS=false
# ENCRYPTION_KEY=hasil-dari-openssl-rand-base64-32
